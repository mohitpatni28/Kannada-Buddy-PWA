{
  "name": "kannada-buddy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-service-worker.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "content:pilot": "node scripts/enrich-library.mjs --scope pilot",
    "content:validate": "node scripts/validate-library-enrichment.mjs data/library-enrichment-pilot.json",
    "content:all": "node scripts/enrich-library.mjs --scope all --output data/library-enrichment-all.json",
    "content:validate-all": "node scripts/validate-library-enrichment.mjs data/library-enrichment-all.json",
    "audio:generate": "audio/.venv/bin/python audio/generate.py",
    "audio:validate": "audio/.venv/bin/python audio/validate.py",
    "audio:package": "node scripts/package-reviewed-audio.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "reviews:check": "node --experimental-strip-types scripts/publish-reviewed-phrases.mjs --check",
    "reviews:apply": "node --experimental-strip-types scripts/publish-reviewed-phrases.mjs --write"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "next": "16.2.10",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.15.30",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "30.1.1",
    "typescript": "5.7.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
