{
  "name": "kannada-buddy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-service-worker.mjs",
    "start": "next start",
    "lint": "next lint",
    "content:pilot": "node scripts/enrich-library.mjs --scope pilot",
    "content:validate": "node scripts/validate-library-enrichment.mjs data/library-enrichment-pilot.json",
    "content:all": "node scripts/enrich-library.mjs --scope all --output data/library-enrichment-all.json",
    "content:validate-all": "node scripts/validate-library-enrichment.mjs data/library-enrichment-all.json",
    "audio:generate": "audio/.venv/bin/python audio/generate.py",
    "audio:validate": "audio/.venv/bin/python audio/validate.py",
    "audio:package": "node scripts/package-reviewed-audio.mjs"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "typescript": "5.7.3"
  }
}
